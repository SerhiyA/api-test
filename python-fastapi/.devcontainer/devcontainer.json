{
  "name": "python-fastapi",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "app-python",
  "workspaceFolder": "/workspace/python-fastapi",
  "forwardPorts": [3002],
  "postCreateCommand": "pip install --user -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
